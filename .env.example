# Environment & Version
APP_ENV=development
APP_VERSION=0.1.0

# Database Configuration (MySQL 8.x via PyMySQL)
DATABASE_URL=mysql+pymysql://<user>:<password>@localhost:3306/<db_name>
TEST_DATABASE_URL=mysql+pymysql://<test_user>:<test_password>@localhost:3306/<test_db_name>
DATABASE_ECHO=false

# API & UI Server Configuration
API_HOST=127.0.0.1
API_PORT=8000
STREAMLIT_PORT=8501
CORS_ALLOWED_ORIGINS=["http://localhost:8501", "http://127.0.0.1:8501"]

# Local Storage Directory
DATA_DIR=./data

# External Execution Providers & APIs (Phase 2)
FFMPEG_PATH=ffmpeg
OLLAMA_BASE_URL=http://localhost:11434
YOUTUBE_API_KEY=<your_youtube_api_key>
DISCOVERY_MAX_RESULTS=25
DISCOVERY_MAX_QUERIES_PER_RUN=5

# Observability & Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Idempotency & Job Execution Settings
JOB_DEFAULT_MAX_RETRIES=3
JOB_LOCK_TIMEOUT_SECONDS=300
